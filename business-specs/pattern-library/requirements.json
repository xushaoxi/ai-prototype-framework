{
  "schemaVersion": 1,
  "id": "backend-pattern-library",
  "name": "后台通用原型模式库",
  "template": "typed-pattern-composition",
  "scope": "有限后台模板与本地业务仿真，非真实认证/服务端权限/流程引擎",
  "catalogSource": "src/app/patterns/catalog.ts",
  "typeSource": "src/core/patterns/types.ts",
  "ruleSource": "src/mocks/store.ts",
  "api": {
    "read": {
      "method": "GET",
      "path": "/api/patterns/snapshot",
      "response": "PatternSnapshot"
    },
    "write": {
      "method": "POST",
      "path": "/api/patterns/actions",
      "body": [
        "version",
        "action"
      ],
      "response": "PatternSnapshot"
    }
  },
  "storage": {
    "key": "prototype-workbench:patterns:v1",
    "maxBytes": 2097152,
    "isolatedFrom": "T01 registry module snapshot",
    "concurrency": "optimistic snapshot version; local browser simulation, no cross-process transaction guarantee"
  },
  "snapshotCollections": [
    "records",
    "deletedRecords",
    "nodes",
    "roles",
    "users",
    "tasks",
    "settings",
    "notices",
    "audit",
    "drafts",
    "files"
  ],
  "actions": [
    "record.save",
    "record.delete",
    "record.restore",
    "record.purge",
    "record.status",
    "record.import",
    "node.save",
    "node.delete",
    "role.save",
    "role.delete",
    "user.save",
    "user.delete",
    "task.decide",
    "settings.save",
    "notice.read",
    "draft.save",
    "draft.delete",
    "file.add",
    "file.delete",
    "reset",
    "backup.restore"
  ],
  "recordTransitions": [
    {
      "from": "draft",
      "to": "active"
    },
    {
      "from": "active",
      "to": "archived"
    },
    {
      "from": "archived",
      "to": "draft"
    }
  ],
  "approvalTransitions": [
    {
      "from": "pending",
      "to": "approved"
    },
    {
      "from": "pending",
      "to": "rejected",
      "requires": "nonempty comment"
    }
  ],
  "templates": [
    {
      "id": "advanced-table",
      "name": "高级表格",
      "route": "#/patterns/advanced-table"
    },
    {
      "id": "tree-table",
      "name": "树形表格",
      "route": "#/patterns/tree-table"
    },
    {
      "id": "card-list",
