      "label": "对接人",
      "type": "text",
      "required": true,
      "searchable": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "maxLength": 30
    },
    {
      "key": "amount",
      "label": "合同金额",
      "type": "number",
      "required": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "min": 0,
      "max": 999999999
