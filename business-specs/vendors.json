{
  "schemaVersion": 1,
  "id": "vendors",
  "name": "供应商台账",
  "template": "T01",
  "codePrefix": "VEN",
  "fields": [
    {
      "key": "code",
      "label": "供应商编号",
      "type": "text",
      "inTable": true,
      "inForm": false,
      "inDetail": true,
      "width": 154,
      "required": false
    },
    {
      "key": "name",
      "label": "供应商名称",
      "type": "text",
      "required": true,
      "searchable": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "maxLength": 80,
      "width": 200
    },
    {
      "key": "category",
      "label": "合作类别",
      "type": "select",
      "required": true,
      "searchable": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "options": [
        {
          "label": "设备供应",
          "value": "设备供应"
        },
        {
          "label": "技术服务",
          "value": "技术服务"
        },
        {
          "label": "行政服务",
          "value": "行政服务"
        },
        {
          "label": "其他",
          "value": "其他"
        }
      ]
    },
    {
      "key": "owner",
      "label": "对接人",
      "type": "text",
      "required": true,
      "searchable": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "maxLength": 30
    },
    {
      "key": "amount",
      "label": "合同金额",
      "type": "number",
      "required": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true,
      "min": 0,
      "max": 999999999
    },
    {
      "key": "date",
      "label": "登记日期",
      "type": "date",
      "required": true,
      "inTable": true,
      "inForm": true,
      "inDetail": true
    },
    {
      "key": "notes",
      "label": "合作备注",
      "type": "textarea",
      "inTable": false,
      "inForm": true,
      "inDetail": true,
      "maxLength": 500,
      "required": false
    }
  ],
  "statuses": [
    {
      "value": "pending",
      "label": "待评估"
    },
    {
      "value": "active",
      "label": "合作中"
    },
    {
      "value": "disabled",
      "label": "已停用"
    }
  ],
  "actions": [
    {
      "key": "approve",
      "from": [
        "pending"
      ],
      "to": "active"
    },
    {
      "key": "disable",
      "from": [
        "active"
      ],
      "to": "disabled"
    },
    {
      "key": "reopen",
      "from": [
        "disabled"
      ],
      "to": "pending"
    }
  ],
  "requirements": [
    {
      "id": "VEN-001",
      "acceptance": "关键词、状态、类别组合查询与分页正确；关键词和类别点击查询或关键词框按Enter统一提交并回到第一页；状态标签显示计数，默认不展示重复统计卡片"
    },
    {
      "id": "VEN-002",
      "acceptance": "新增校验必填并自动分配唯一编号"
    },
    {
      "id": "VEN-003",
      "acceptance": "详情显示完整字段及活动记录"
    },
    {
      "id": "VEN-004",
      "acceptance": "编辑刷新持久化且阻止旧版本覆盖"
    },
    {
      "id": "VEN-005",
      "acceptance": "仅允许合法状态流转并记录审计"
    },
    {
      "id": "VEN-006",
      "acceptance": "仅初始状态允许删除"
    },
    {
      "id": "VEN-007",
      "acceptance": "只读角色界面禁止写操作（演示权限）"
    },
    {
      "id": "VEN-008",
      "acceptance": "模块数据隔离和确定性重置"
    },
    {
      "id": "VEN-009",
      "acceptance": "错误可恢复且无部分写入"
    },
    {
      "id": "VEN-010",
      "acceptance": "功能标签切换保留当前模块查询、排序、页码、展开及滚动位置，关闭重开回到初始条件；台账不重复展示大标题说明，新增放列表操作栏，对照指南在工作台顶栏。"
    },
    {
      "id": "VEN-011",
      "acceptance": "支持80–600px拖动与键盘调整列宽，名称和操作列保留；显示列与宽度偏好按模块在浏览器保存并可恢复。导出单独选择至少一个列表数据列，可选隐藏列，不改变显示设置，范围遵守当前已提交查询全部页，保持CSV安全转义。"
    },
    {
      "id": "VEN-012",
      "acceptance": "列设置支持拖拽及上下箭头在固定分区内调整顺序，数据列可固定左侧或右侧；顺序和固定状态按模块保存且兼容旧偏好，窄屏或空间不足时暂停固定避免遮挡，导出列顺序随列表设置。"
    },
    {
      "id": "VEN-013",
      "acceptance": "查询区明确区分已生效筛选与待提交修改；可单独清除关键词或类别条件，状态筛选与顶部状态标签同步；有条件的空结果提供清除筛选入口；横向溢出有提示且可键盘滚动，截断文本可聚焦查看全文。"
    }
  ]
}
