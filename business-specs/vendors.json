  "statuses": [
    {
      "value": "pending",
      "label": "待评估"
    },
    {
      "value": "active",
      "label": "合作中"
    },
    {
      "value": "disabled",
      "label": "已停用"
    }
  ],
  "actions": [
    {
      "key": "approve",
      "from": [
        "pending"
      ],
      "to": "active"
    },
    {
      "key": "disable",
      "from": [
        "active"
      ],
      "to": "disabled"
    },
    {
      "key": "reopen",
      "from": [
        "disabled"
      ],
      "to": "pending"
    }
  ],
  "requirements": [
    {
      "id": "VEN-001",
