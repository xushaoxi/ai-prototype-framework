{
  "name": "ai-prototype-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "规范驱动、可复用的 T01 业务原型框架",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run spec:check && npm run typecheck && npm run lint && npm test && npm run build",
    "spec:check": "node scripts/check-spec.mjs",
    "create:project": "node scripts/create-project.mjs",
    "generate:module": "node scripts/generate-module.mjs",
    "deliver": "node scripts/deliver.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "antd": "6.6.7",
    "dayjs": "1.11.18",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "msw": { "workerDirectory": ["public"] }
}
